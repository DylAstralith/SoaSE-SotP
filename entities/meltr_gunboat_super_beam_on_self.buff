{
    "version": 0,
    "make_dead_on_all_finite_time_actions_done": true,
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": true,
    "time_actions": [
        {
            "first_action_delay_time_value": "beam_charge_value",
            "execution_interval_value": "fixed_one",
            "execution_interval_count_value": "execution_interval_count_value",
            "action_group": {
                "actions": [
                    {
                        "action_type": "use_unit_operators_on_units_in_radius_of_unit",
                        "radius_origin_unit": {
                            "unit_type": "target"
                        },
                        "include_radius_origin_unit": false,
                        "radius_value": "cannon_splash_radius_value",
                        "operators_constraint": {
                            "constraint_type": "unit_passes_target_filter",
                            "target_filter_id": "cannon_splash_target_filter",
                            "unit": {
                                "unit_type": "operand_destination"
                            }
                        },
                        "operators": [
                            {
                                "penetration_value": "penetration_value",
                                "damage_source": "ability",
                                "operator_type": "apply_damage",
                                "damage_value": "cannon_splash_damage_rate_value",
                                "damage_affect_type": "hull_and_armor_and_shields"
                            }
                        ]
                    },
                    {
                        "action_type": "use_unit_operators_on_single_unit",
                        "destination_unit": {
                            "unit_type": "target"
                        },
                        "operators": [
                            {
                                "operator_type": "apply_damage",
                                "damage_source": "ability",
                                "damage_affect_type": "hull_and_armor_and_shields",
                                "damage_value": "damage_rate_value",
                                "penetration_value": "penetration_value"
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "trigger_event_actions": [
        {
            "trigger_event_type": "on_buff_started",
            "action_group": {
                "actions": [
                    {
                        "action_type": "use_unit_operators_on_single_unit",
                        "destination_unit": {
                            "unit_type": "target"
                        },
                        "operators": [
                            {
                                "operator_type": "play_weapon_effects",
                                "effect_alias_binding": "unit_skin",
                                "mesh_point": "ability",
                                "effects": {
                                    "charge_effect": "meltr_super_heavy_beam_charge",
                                    "muzzle_effect": "meltr_super_heavy_beam_muzzle",
                                    "beam_effect": "meltr_super_heavy_beam",
                                    "hit_hull_effect": "meltr_weapon_heavy_beam_hit_hull",
                                    "hit_shield_effect": "meltr_weapon_heavy_beam_hit_shield",
                                    "hit_shield_impact_radius_t": 1
                                },
                                "charge_duration": "beam_charge_value",
                                "beam_duration": "execution_interval_count_value"
                            }
                        ]
                    }
                ]
            }
        }
    ]
}