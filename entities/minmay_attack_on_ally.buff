{
    "version": 0,
    "make_dead_on_parent_buff_made_dead": true,
    "make_dead_on_distance_to_parent_buff_exceeded": {
        "distance": "minmay_attack_radius_value"
    },
    "stacking_limit": {
        "stacking_limit": "fixed_one",
        "stacking_limit_met_behavior": "preserve_existing_buff"
    },
    "stacking_ownership_type": "for_all_players",
    "restart_other_stacked_buffs_when_started": false,
    "trigger_event_actions": [
        {
            "trigger_event_type": "on_buff_started",
            "action_group": {
                "actions": [
                    {
                        "constraint": {
                            "constraint_type": "composite_not",
                            "constraint": {
                                "constraint_type": "unit_comparison",
                                "unit_a": {
                                    "unit_type": "current_spawner"
                                },
                                "unit_b": {
                                    "unit_type": "previous_spawner"
                                }
                            }
                        },
                        "action_type": "start_buff_effect",
                        "effect_definition": {
                            "binding": "unit_skin",
                            "mesh_point": "center",
                            "effect_by_size": {
                                "small_unit": "minmay_attack_buff_on_ally_small",
                                "medium_unit": "minmay_attack_buff_on_ally_medium",
                                "large_unit": "minmay_attack_buff_on_ally_large"
                            }
                        }
                    }
                ]
            }
        },
        {
            "trigger_event_type": "on_current_spawner_player_ownership_changed",
            "action_group": {
                "actions": [
                    {
                        "action_type": "make_buff_dead"
                    }
                ]
            }
        }
    ],
    "weapon_modifiers": [
        {
            "buff_weapon_modifier_id": "cooldown_duration"
        }
    ],
    "gui": {
        "hud_icon": "minmay_attack_hud_icon",
        "name": "minmay_attack_name",
        "visibility_scope": "positive",
        "tooltip_line_groups": [
            {
                "lines": [
                    {
                        "rendering_type": "buff_weapon_modifier",
                        "weapon_modifier_id": "cooldown_duration"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "antimatter_restore_rate"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "max_linear_speed"
                    }
                ]
            }
        ]
    },
    "unit_modifiers": [
        {
            "buff_unit_modifier_id": "antimatter_restore_rate"
        },
        {
            "buff_unit_modifier_id": "max_linear_speed"
        }
    ]
}
