{
    "version": 0,
    "action_data_source": "spacy_minmay_attack",
    "level_source": "internal_level",
    "min_required_unit_levels": [
        0,
        2,
        4
    ],
    "active_actions": {
        "cooldown_time": "minmay_attack_cooldown_time_value",
        "antimatter_cost": "minmay_attack_antimatter_cost_value",
        "actions": {
            "actions": [
                {
                    "action_type": "use_unit_operators_on_single_unit",
                    "destination_unit": {
                        "unit_type": "current_spawner"
                    },
                    "operators": [
                        {
                            "operator_type": "apply_buff",
                            "buff": "spacy_minmay_attack_on_spawner"
                        }
                    ]
                }
            ]
        },
        "auto_cast": {
            "enabled_by_default_behavior": "always",
            "caster_constraint": {
                "constraint_type": "composite_and",
                "constraints": [
                    {
                        "constraint_type": "unit_passes_unit_constraint",
                        "unit": {
                            "unit_type": "current_spawner"
                        },
                        "unit_constraint": {
                            "constraint_type": "weapon_has_target"
                        }
                    },
                    {
                        "constraint_type": "has_valid_targets_in_radius",
                        "radius_origin_unit": {
                            "unit_type": "current_spawner"
                        },
                        "target_filter_id": "minmay_attack_auto_cast_target_filter",
                        "radius_value": "minmay_attack_radius_value",
                        "target_count_value": "minmay_attack_auto_cast_target_count_value"
                    }
                ]
            }
        }
    },
    "gui": {
        "hud_icon": "minmay_attack_hud_icon",
        "name": "spacy_minmay_attack_name",
        "description": "spacy_minmay_attack_description",
        "targeting": {
            "targeting_type": "radius",
            "values": {
                "radius": "minmay_attack_radius_value"
            }
        },
        "tooltip_line_groups": [
            {
                "lines": [
                    {
                        "rendering_type": "buff_weapon_modifier",
                        "weapon_modifier_id": "cooldown_duration"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "antimatter_restore_rate"
                    },
                    {
                        "rendering_type": "buff_unit_modifier",
                        "unit_modifier_id": "max_linear_speed"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.radius",
                        "value_id": "minmay_attack_radius_value"
                    },
                    {
                        "rendering_type": "single_value",
                        "label_text": "tooltip.ability.duration",
                        "value_id": "minmay_attack_duration_value",
                        "value_suffix": "seconds"
                    }
                ]
            }
        ]
    }
}
